# Konfigurasi Server Caffe Podjok Sendja
PORT=8080
GIN_MODE=release

# Direktori Penyimpanan Berkas & Data Lokal
DATA_DIR=./data

# Pengaturan Basis Data MySQL (XAMPP / Server Produksi)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=caffe_podjok_sendja

# Kunci API Midtrans (QRIS Dinamis Otomatis)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

