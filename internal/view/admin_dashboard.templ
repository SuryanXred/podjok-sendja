package view

import (
	"fmt"
	"caffe-podjok-sendja/internal/catalog"
	"caffe-podjok-sendja/internal/order"
	"caffe-podjok-sendja/internal/staff"
	"caffe-podjok-sendja/internal/storeconfig"
)

templ AdminDashboardPage(activeTab string, report order.AdminReport, categories []catalog.Category, stockList []catalog.StockItem, movements []catalog.StockMovement, cfg storeconfig.Config, message string, staffUser *staff.StaffUser) {
	<!DOCTYPE html>
	<html lang="id">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="theme-color" content="#070D1F"/>
			<title>Dashboard Manajemen • Caffe Podjok Sendja</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/>
			<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body class="glass-admin-body">
			@adminDashboardContent(activeTab, report, categories, stockList, movements, cfg, message, staffUser)
		</body>
	</html>
}

templ adminDashboardContent(activeTab string, report order.AdminReport, categories []catalog.Category, stockList []catalog.StockItem, movements []catalog.StockMovement, cfg storeconfig.Config, message string, staffUser *staff.StaffUser) {
	<div class="glass-admin-viewport">
		if message != "" {
			<aside class="glass-toast-alert" role="status">
				<span class="toast-dot"></span>
				<span>{ message }</span>
			</aside>
		}

		<div class="glass-admin-shell">
			<!-- LEFT LIQUID GLASS SIDEBAR -->
			<aside class="glass-sidebar">
				<div class="glass-sidebar-brand">
					<div class="glass-brand-cube">
						<span class="cube-glyph">☕</span>
					</div>
					<div class="glass-brand-text">
						<h2 class="glass-brand-name">Podjok Sendja</h2>
						<span class="glass-brand-version">v2.4 • Admin Portal</span>
					</div>
				</div>

				<div class="glass-sidebar-menu">
					<span class="glass-menu-kicker">MENU UTAMA</span>
					<nav class="glass-nav-list" aria-label="Navigasi Menu Admin">
						<a href="/admin" class={ "glass-nav-item", templ.KV("is-active", activeTab == "" || activeTab == "laporan") }>
							<span class="nav-icon-box">📊</span>
							<span class="nav-label">Dashboard Ringkasan</span>
							<span class="nav-arrow-indicator">›</span>
						</a>
						<a href="/admin?tab=menu" class={ "glass-nav-item", templ.KV("is-active", activeTab == "menu") }>
							<span class="nav-icon-box">☕</span>
							<span class="nav-label">Katalog Menu Kafe</span>
							<span class="nav-arrow-indicator">›</span>
						</a>
						<a href="/admin?tab=stok" class={ "glass-nav-item", templ.KV("is-active", activeTab == "stok") }>
							<span class="nav-icon-box">📦</span>
							<span class="nav-label">Inventori &amp; Stok Bahan</span>
							<span class="nav-arrow-indicator">›</span>
						</a>
						<a href="/kasir" class="glass-nav-item" target="_blank" rel="noopener">
							<span class="nav-icon-box">📋</span>
							<span class="nav-label">Panel Kasir (Web POS)</span>
							<span class="nav-external-pill">Kasir ↗</span>
						</a>
						<a href="/admin/pesanan" class="glass-nav-item">
							<span class="nav-icon-box">🧾</span>
							<span class="nav-label">Antrean Pesanan Dapur</span>
							<span class="nav-arrow-indicator">›</span>
						</a>
						<a href="/admin/laporan/ekspor?period=all" class="glass-nav-item" download>
							<span class="nav-icon-box">📈</span>
							<span class="nav-label">Laporan Penjualan (CSV)</span>
							<span class="nav-arrow-indicator">›</span>
						</a>
						<a href="/admin?tab=pengaturan" class={ "glass-nav-item", templ.KV("is-active", activeTab == "pengaturan") }>
							<span class="nav-icon-box">⚙️</span>
							<span class="nav-label">Pengaturan Jam Kafe</span>
							<span class="nav-arrow-indicator">›</span>
						</a>
					</nav>
				</div>

				if staffUser != nil {
					<div class="glass-user-card">
						<div class="user-card-main">
							<div class="user-avatar-frame">
								<span class="avatar-initial">{ string([]rune(staffUser.Name)[0:1]) }</span>
								<span class="avatar-online-dot" title="Sesi Shift Aktif"></span>
							</div>
							<div class="user-info-text">
								<strong class="user-display-name">{ staffUser.Name }</strong>
								<span class="user-display-role">{ staffUser.Role.Label() }</span>
								<span class="user-shift-status">• Shift Aktif</span>
							</div>
						</div>
						<a href="/pegawai/keluar" class="btn-glass-logout" title="Keluar dari sesi administrator">
							<span class="logout-icon">🚪</span>
							<span>Keluar Shift</span>
						</a>
					</div>
				}
			</aside>

			<!-- MAIN DEDICATED CONTENT CANVAS -->
			<main class="glass-main-canvas">
				<!-- TOP HEADER BAR -->
				<header class="glass-topbar">
					<div class="glass-topbar-title-wrap">
						<h1 class="glass-header-title">Dashboard Manajemen</h1>
						<p class="glass-header-desc">Pemantauan Penjualan, Antrean, dan Inventori Bahan Baku • Real-Time Live Sync</p>
					</div>

					<div class="glass-topbar-actions">
						<!-- Live Pulse Bar -->
						<div class="glass-live-pill" id="adminLiveBar">
							<span class="live-pulse-indicator" aria-hidden="true">
								<span class="live-pulse-ring"></span>
								<span class="live-pulse-core"></span>
							</span>
							<div class="live-pulse-meta">
								<span class="live-title-text">Live Sync Aktif</span>
								<span class="live-last-sync-text" id="liveLastSync">Menghubungkan pembaruan...</span>
							</div>
							<div class="live-interval-picker">
								<select id="liveIntervalSelect" class="glass-mini-select" aria-label="Interval Pembaruan Otomatis">
									<option value="5000" selected>5 Detik</option>
									<option value="10000">10 Detik</option>
									<option value="30000">30 Detik</option>
									<option value="0">Manual</option>
								</select>
							</div>
							<button type="button" id="btnLiveRefresh" class="btn-live-icon-refresh" title="Segarkan Data Sekarang">
								<span class="refresh-icon" aria-hidden="true">🔄</span>
							</button>
						</div>

						<!-- Search Box -->
						<div class="glass-search-box">
							<span class="search-lens-icon">🔍</span>
							<input type="text" id="adminSearchInput" class="glass-search-input" placeholder="Cari menu, kode pesanan (#PDS-...), nama pelanggan..."/>
						</div>

						<!-- Notification Bell -->
						<div class="glass-bell-btn" title="3 Peringatan Operasional Kafe Aktif">
							<span class="bell-glyph">🔔</span>
							<span class="bell-badge-count">3</span>
						</div>

						<!-- Quick Link to Cashier -->
						<a href="/kasir" class="btn-topbar-kasir" target="_blank" rel="noopener" title="Buka Panel Kasir Meja Depan">
							<span>+ Buka Kasir</span>
						</a>

						<!-- Settings Gear -->
						<a href="/admin?tab=pengaturan" class="glass-gear-btn" title="Pengaturan Kafe">
							<span>⚙️</span>
						</a>
					</div>
				</header>

				<!-- SUB-TAB NAVIGATION UNTUK MOBILE/TABLET -->
				<nav class="glass-mobile-tabs" aria-label="Navigasi bagian admin">
					<a href="/admin" class={ "glass-tab-pill", templ.KV("is-active", activeTab == "" || activeTab == "laporan") }>
						Ringkasan
					</a>
					<a href="/admin?tab=menu" class={ "glass-tab-pill", templ.KV("is-active", activeTab == "menu") }>
						Katalog Menu
					</a>
					<a href="/admin?tab=stok" class={ "glass-tab-pill", templ.KV("is-active", activeTab == "stok") }>
						Kontrol Stok
					</a>
					<a href="/admin?tab=pengaturan" class={ "glass-tab-pill", templ.KV("is-active", activeTab == "pengaturan") }>
						Pengaturan
					</a>
				</nav>

				<!-- TAB CONTENT -->
				if activeTab == "" || activeTab == "laporan" {
					@adminTabReport(report, stockList, movements)
				} else if activeTab == "menu" {
					@adminTabMenu(categories)
				} else if activeTab == "stok" {
					@adminTabStock(stockList, movements)
				} else if activeTab == "pengaturan" {
					@adminTabSettings(cfg)
				}
			</main>
		</div>

		<script>
		(function() {
			var pollTimer = null;
			var select = document.getElementById("liveIntervalSelect");
			var refreshBtn = document.getElementById("btnLiveRefresh");
			var syncLabel = document.getElementById("liveLastSync");

			function escapeHtml(str) {
				if (!str) return "";
				return String(str)
					.replace(/&/g, "&amp;")
					.replace(/</g, "&lt;")
					.replace(/>/g, "&gt;")
					.replace(/"/g, "&quot;")
					.replace(/'/g, "&#039;");
			}

			function updateDashboard(data) {
				if (!data) return;

				if (syncLabel && data.timestamp) {
					syncLabel.textContent = "Pembaruan: " + data.timestamp;
				}

				if (data.metrics) {
					var elSales = document.getElementById("kpiConfirmedSales");
					if (elSales) elSales.textContent = data.metrics.confirmed_sales;

					var elTotal = document.getElementById("kpiTotalOrders");
					if (elTotal) elTotal.textContent = String(data.metrics.total_orders);

					var elSub = document.getElementById("kpiTotalSub");
					if (elSub) elSub.textContent = data.metrics.completed_orders + " pesanan selesai lunas, " + data.metrics.pending_orders + " menunggu";

					var elAvg = document.getElementById("kpiAvgOrderValue");
					if (elAvg) elAvg.textContent = "Rata-rata: " + data.metrics.average_order_value + " ↗";

					var elMhs = document.getElementById("kpiMahasiswaCount");
					if (elMhs) elMhs.textContent = String(data.metrics.mahasiswa_orders);

					var elUmum = document.getElementById("kpiUmumCount");
					if (elUmum) elUmum.textContent = String(data.metrics.umum_orders);

					var elCash = document.getElementById("kpiCashCount");
					if (elCash) elCash.textContent = String(data.metrics.cash_orders);

					var elQris = document.getElementById("kpiQRISCount");
					if (elQris) elQris.textContent = String(data.metrics.qris_orders);
				}

				var tbodyTop = document.getElementById("tableTopProductsBody");
				if (tbodyTop && data.top_products) {
					if (data.top_products.length === 0) {
						tbodyTop.innerHTML = '<tr><td colspan="3" class="text-center text-muted py-3">Belum ada data penjualan tercatat.</td></tr>';
					} else {
						var htmlTop = "";
						for (var i = 0; i < data.top_products.length; i++) {
							var p = data.top_products[i];
							htmlTop += "<tr>" +
								"<td><strong>" + escapeHtml(p.name) + "</strong></td>" +
								"<td class=\"text-right tabular-nums\">" + p.quantity + " porsi</td>" +
								"<td class=\"text-right tabular-nums\">" + escapeHtml(p.sales_formatted) + "</td>" +
								"</tr>";
						}
						tbodyTop.innerHTML = htmlTop;
					}
				}

				var tbodyOrders = document.getElementById("tableRecentOrdersBody");
				if (tbodyOrders && data.recent_orders) {
					if (data.recent_orders.length === 0) {
						tbodyOrders.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">Belum ada pesanan terbaru.</td></tr>';
					} else {
						var htmlOrders = "";
						for (var j = 0; j < data.recent_orders.length; j++) {
							var o = data.recent_orders[j];
							var badgeClass = "badge-pending";
							var statusText = escapeHtml(o.status_label);
							if (o.status_code === "paid" || o.status_code === "completed") {
								badgeClass = "badge-delivered";
								statusText = "Selesai Lunas";
							} else if (o.status_code === "preparing" || o.status_code === "in_process") {
								badgeClass = "badge-processing";
								statusText = "Sedang Diracik";
							} else if (o.status_code === "ready") {
								badgeClass = "badge-shipped";
								statusText = "Siap Diambil";
							}

							var custBadge = o.customer_type === "mahasiswa" ? '<span class="cust-badge-mhs">Mhs UNISM</span>' : '';
							var tableText = o.table_number ? 'Meja ' + escapeHtml(o.table_number) : 'Bawa Pulang';

							htmlOrders += "<tr>" +
								"<td>" +
									'<a href="/pesanan/' + encodeURIComponent(o.code) + '" class="order-id-link" target="_blank" rel="noopener">#' + escapeHtml(o.code) + '</a>' +
									'<div class="order-time-label"><time>' + escapeHtml(o.time_formatted) + ' WITA</time></div>' +
								"</td>" +
								"<td>" +
									'<div class="customer-row"><strong class="cust-name-text">' + escapeHtml(o.customer_name) + '</strong> ' + custBadge + '</div>' +
									'<span class="cust-table-text">' + tableText + '</span>' +
								"</td>" +
								'<td class="text-right tabular-nums"><strong>' + escapeHtml(o.total_formatted) + '</strong></td>' +
								'<td><span class="status-badge-glass ' + badgeClass + '">' + statusText + '</span></td>' +
								'<td class="text-center">' +
									'<a href="/kasir/pesanan/' + encodeURIComponent(o.code) + '/cetak" class="btn-action-receipt" target="_blank" rel="noopener">🖨️ Struk</a>' +
								'</td>' +
								"</tr>";
						}
						tbodyOrders.innerHTML = htmlOrders;
					}
				}

				if (data.stock_summary) {
					var elLow = document.getElementById("stockStatLow");
					if (elLow) elLow.textContent = String(data.stock_summary.low_count + data.stock_summary.empty_count);
				}
			}

			function fetchMonitoringData() {
				if (refreshBtn) refreshBtn.classList.add("is-refreshing");
				fetch("/api/admin/live-monitoring", {
					headers: { "Accept": "application/json" }
				})
				.then(function(res) {
					if (!res.ok) throw new Error("HTTP error " + res.status);
					return res.json();
				})
				.then(function(data) {
					updateDashboard(data);
				})
				.catch(function(err) {
					console.warn("Live monitoring sync error:", err);
					if (syncLabel) syncLabel.textContent = "Koneksi terputus (" + new Date().toLocaleTimeString() + ")";
				})
				.finally(function() {
					if (refreshBtn) refreshBtn.classList.remove("is-refreshing");
				});
			}

			function setupInterval() {
				if (pollTimer) {
					clearInterval(pollTimer);
					pollTimer = null;
				}
				if (!select) return;
				var val = parseInt(select.value, 10);
				if (val > 0) {
					pollTimer = setInterval(fetchMonitoringData, val);
				}
			}

			if (select) {
				select.addEventListener("change", function() {
					setupInterval();
					if (parseInt(select.value, 10) > 0) {
						fetchMonitoringData();
					}
				});
			}

			if (refreshBtn) {
				refreshBtn.addEventListener("click", function() {
					fetchMonitoringData();
				});
			}

			setupInterval();
			setTimeout(fetchMonitoringData, 800);
		})();
		</script>
	</div>
}

templ adminTabReport(report order.AdminReport, stockList []catalog.StockItem, movements []catalog.StockMovement) {
	<div class="glass-dashboard-container">
		<!-- ROW 1: EMPAT KARTU METRIK KPI KACA CAIR -->
		<div class="glass-kpi-grid">
			<!-- Kartu 1: Total Menu Aktif -->
			<div class="glass-metric-card">
				<div class="metric-icon-box icon-cyan">
					<span class="metric-glyph">📦</span>
				</div>
				<span class="metric-title">Total Menu Aktif</span>
				<strong class="metric-big-num" id="kpiTotalProductsCount">{ fmt.Sprintf("%d", len(stockList)) }</strong>
				<span class="metric-trend trend-positive">17 Menu Siap Dipesan di 4 Kategori ↗</span>
			</div>

			<!-- Kartu 2: Stok Porsi Menipis -->
			<div class="glass-metric-card">
				<div class="metric-icon-box icon-amber">
					<span class="metric-glyph">⚠️</span>
				</div>
				<span class="metric-title">Stok Porsi Menipis</span>
				<strong class="metric-big-num num-amber" id="stockStatLow">{ fmt.Sprintf("%d", countStockByStatus(stockList, "low") + countStockByStatus(stockList, "empty")) }</strong>
				<span class="metric-trend trend-warning">Sisa porsi ≤ 5 (Butuh Restock) ↘</span>
			</div>

			<!-- Kartu 3: Antrean Pesanan Berjalan -->
			<div class="glass-metric-card">
				<div class="metric-icon-box icon-blue">
					<span class="metric-glyph">📋</span>
				</div>
				<span class="metric-title">Antrean Pesanan Berjalan</span>
				<strong class="metric-big-num" id="kpiTotalOrders">{ fmt.Sprintf("%d", report.Metrics.PendingPayment + report.Metrics.InProcess) }</strong>
				<span class="metric-trend trend-neutral" id="kpiTotalSub">{ fmt.Sprintf("%d pesanan selesai lunas, %d menunggu", report.Metrics.Completed, report.Metrics.PendingPayment) }</span>
			</div>

			<!-- Kartu 4: Total Omzet Penjualan -->
			<div class="glass-metric-card">
				<div class="metric-icon-box icon-emerald">
					<span class="metric-glyph">💵</span>
				</div>
				<span class="metric-title">Total Omzet Penjualan</span>
				<strong class="metric-big-num num-emerald" id="kpiConfirmedSales">{ FormatRupiah(report.Metrics.ConfirmedSales) }</strong>
				<span class="metric-trend trend-positive" id="kpiAvgOrderValue">Rata-rata: { FormatRupiah(report.AverageOrderValue) } ↗</span>
			</div>
		</div>

		<!-- ROW 2: DUA KOLOM UTAMA (GRAFIK TREN KAFE & TABEL PESANAN TERKINI) -->
		<div class="glass-analytics-row">
			<!-- PANEL KIRI: Tren Penjualan & Pergerakan Stok Kafe -->
			<section class="glass-card glass-chart-panel" aria-labelledby="heading-stock-chart">
				<div class="glass-card-header">
					<div>
						<h3 id="heading-stock-chart" class="glass-card-title">Tren Penjualan &amp; Pergerakan Stok Kafe</h3>
						<p class="glass-card-subtitle">Porsi menu terjual vs ketersediaan bahan baku harian (Real-Time)</p>
					</div>
					<div class="glass-card-actions">
						<select class="glass-dropdown-select" aria-label="Rentang Waktu Analisis">
							<option selected>Hari Ini (Jam Operasional)</option>
							<option>7 Hari Terakhir</option>
							<option>Bulan Berjalan</option>
						</select>
					</div>
				</div>

				<!-- Glowing Area & Line SVG Chart (Warna Tema Kafe: Golden Crema & Roasted Terracotta) -->
				<div class="glass-chart-wrap">
					<svg class="glass-svg-canvas" viewBox="0 0 540 220" preserveAspectRatio="none" aria-hidden="true">
						<defs>
							<linearGradient id="caramelAreaGlow" x1="0" y1="0" x2="0" y2="1">
								<stop offset="0%" stop-color="#F59E0B" stop-opacity="0.38"></stop>
								<stop offset="100%" stop-color="#F59E0B" stop-opacity="0.0"></stop>
							</linearGradient>
							<filter id="caramelNeonGlow" x="-20%" y="-20%" width="140%" height="140%">
								<feGaussianBlur stdDeviation="3" result="blur"></feGaussianBlur>
								<feComposite in="SourceGraphic" in2="blur" operator="over"></feComposite>
							</filter>
						</defs>
						<!-- Grid Lines -->
						<line x1="40" y1="40" x2="520" y2="40" stroke="rgba(255,248,240,0.06)" stroke-dasharray="3 3"></line>
						<line x1="40" y1="90" x2="520" y2="90" stroke="rgba(255,248,240,0.06)" stroke-dasharray="3 3"></line>
						<line x1="40" y1="140" x2="520" y2="140" stroke="rgba(255,248,240,0.06)" stroke-dasharray="3 3"></line>
						<line x1="40" y1="190" x2="520" y2="190" stroke="rgba(255,248,240,0.12)"></line>

						<!-- Area Fill (Golden Crema) -->
						<path d="M 50 160 Q 140 120, 230 80 T 410 50 L 510 110 L 510 190 L 50 190 Z" fill="url(#caramelAreaGlow)"></path>

						<!-- Caramel Crema Line (Porsi Menu Terjual) -->
						<path d="M 50 160 Q 140 120, 230 80 T 410 50 L 510 110" fill="none" stroke="#F59E0B" stroke-width="3" filter="url(#caramelNeonGlow)"></path>

						<!-- Terracotta Line (Porsi Bahan Menipis) -->
						<path d="M 50 180 Q 140 170, 230 160 T 410 145 L 510 155" fill="none" stroke="#EA580C" stroke-width="2" stroke-dasharray="4 2"></path>

						<!-- Data Points -->
						<circle cx="50" cy="160" r="4" fill="#F59E0B"></circle>
						<circle cx="140" cy="120" r="4" fill="#F59E0B"></circle>
						<circle cx="230" cy="80" r="5" fill="#FFF7ED" stroke="#F59E0B" stroke-width="2"></circle>
						<circle cx="320" cy="100" r="4" fill="#F59E0B"></circle>
						<circle cx="410" cy="50" r="6" fill="#FFF7ED" stroke="#F59E0B" stroke-width="2"></circle>
						<circle cx="510" cy="110" r="4" fill="#F59E0B"></circle>
					</svg>

					<div class="chart-timeline-labels">
						<span>09:00</span>
						<span>12:00</span>
						<span>15:00</span>
						<span>18:00</span>
						<span>21:00</span>
					</div>
				</div>

				<!-- Chart Legend & Real-Time Segments -->
				<div class="glass-chart-footer">
					<div class="chart-legend-items">
						<span class="legend-chip"><span class="chip-dot dot-caramel"></span> Porsi Menu Terjual</span>
						<span class="legend-chip"><span class="chip-dot dot-terracotta"></span> Porsi Bahan Menipis</span>
					</div>
					<div class="chart-breakdown-tags">
						<span class="breakdown-tag tag-mhs" title="Diskon Mahasiswa UNISM Terverifikasi">
							<strong id="kpiMahasiswaCount">{ fmt.Sprintf("%d", report.MahasiswaOrders) }</strong> Mhs UNISM (Diskon 25% Terkunci)
						</span>
						<span class="breakdown-tag tag-umum" title="Pelanggan Umum">
							<strong id="kpiUmumCount">{ fmt.Sprintf("%d", report.UmumOrders) }</strong> Tamu Umum
						</span>
						<span class="breakdown-tag tag-qris" title="Pembayaran QRIS Midtrans Dinamis">
							<strong id="kpiQRISCount">{ fmt.Sprintf("%d", report.QRISOrders) }</strong> Dynamic QRIS Midtrans
						</span>
						<span class="breakdown-tag tag-cash" title="Pembayaran Tunai Kasir">
							<strong id="kpiCashCount">{ fmt.Sprintf("%d", report.CashOrders) }</strong> Tunai di Kasir
						</span>
					</div>
				</div>
			</section>

			<!-- PANEL KANAN: Tabel Pesanan Terkini -->
			<section class="glass-card glass-orders-panel" aria-labelledby="heading-recent-orders">
				<div class="glass-card-header">
					<div>
						<h3 id="heading-recent-orders" class="glass-card-title">Riwayat Transaksi Terbaru</h3>
						<p class="glass-card-subtitle">Pesanan terkini pelanggan kafe (Meja &amp; Bawa Pulang)</p>
					</div>
					<div class="glass-card-actions">
						<a href="/kasir" class="btn-glass-new-order" target="_blank" rel="noopener">
							<span>+ Transaksi Kasir Baru</span>
						</a>
					</div>
				</div>

				<div class="glass-table-responsive">
					<table class="glass-data-table">
						<thead>
							<tr>
								<th>Kode Pesanan</th>
								<th>Pelanggan &amp; Meja</th>
								<th class="text-right">Total Bayar</th>
								<th>Status Pesanan</th>
								<th class="text-center">Aksi Struk</th>
							</tr>
						</thead>
						<tbody id="tableRecentOrdersBody">
							if len(report.RecentOrders) == 0 {
								<tr>
									<td colspan="5" class="text-center text-muted py-3">Belum ada riwayat pesanan hari ini.</td>
								</tr>
							} else {
								for _, ord := range report.RecentOrders {
									<tr>
										<td>
											<a href={ templ.URL("/pesanan/" + ord.Code) } class="order-id-link" target="_blank" rel="noopener">
												#{ ord.Code }
											</a>
											<div class="order-time-label"><time>{ ord.CreatedAt.Format("15:04 WIB") }</time></div>
										</td>
										<td>
											<div class="customer-row">
												<strong class="cust-name-text">{ ord.CustomerName }</strong>
												if ord.CustomerType == "mahasiswa" {
													<span class="cust-badge-mhs">Mhs UNISM</span>
												}
											</div>
											<span class="cust-table-text">
												if ord.TableNumber != "" {
													Meja { ord.TableNumber }
												} else {
													Bawa Pulang (Takeaway)
												}
											</span>
										</td>
										<td class="text-right tabular-nums">
											<strong>{ FormatRupiah(ord.Total) }</strong>
										</td>
										<td>
											if ord.OrderStatus == order.OrderStatusCompleted || ord.OrderStatus == order.OrderStatusPaid {
												<span class="status-badge-glass badge-delivered">Selesai Lunas</span>
											} else if ord.OrderStatus == order.OrderStatusPreparing {
												<span class="status-badge-glass badge-processing">Sedang Diracik</span>
											} else if ord.OrderStatus == order.OrderStatusReady {
												<span class="status-badge-glass badge-shipped">Siap Diambil</span>
											} else {
												<span class="status-badge-glass badge-pending">{ ord.StatusLabel() }</span>
											}
										</td>
										<td class="text-center">
											<a href={ templ.URL("/kasir/pesanan/" + ord.Code + "/cetak") } target="_blank" rel="noopener" class="btn-action-receipt" title="Cetak struk kasir">
												🖨️ Cetak Struk
											</a>
										</td>
									</tr>
								}
							}
						</tbody>
					</table>
				</div>
			</section>
		</div>

		<!-- ROW 3: BILAH PERINGATAN OPERASIONAL KAFE (INVENTORY ALERTS) -->
		<section class="glass-card glass-alerts-panel" aria-labelledby="heading-inventory-alerts">
			<div class="glass-card-header">
				<div>
					<h3 id="heading-inventory-alerts" class="glass-card-title">Peringatan Operasional &amp; Inventori Kafe</h3>
					<p class="glass-card-subtitle">Notifikasi otomatis bahan baku menipis, diskon mahasiswa, dan status payment gateway</p>
				</div>
			</div>

			<div class="glass-alerts-grid">
				<!-- Peringatan 1: Stok Menipis -->
				<div class="alert-glass-box alert-box-warning">
					<div class="alert-box-icon">
						<span>⚠️</span>
					</div>
					<div class="alert-box-content">
						<strong class="alert-box-title">Peringatan Stok Bahan Baku Menipis</strong>
						<p class="alert-box-desc">
							if countStockByStatus(stockList, "low") > 0 {
								Terdapat { fmt.Sprintf("%d", countStockByStatus(stockList, "low")) } menu tersisa ≤ 5 porsi (Kopi Arabika/Susu). Segera restock bahan dapur.
							} else {
								Seluruh bahan menu saat ini dalam batas ketersediaan porsi aman.
							}
						</p>
					</div>
					<div class="alert-box-action">
						<a href="/admin?tab=stok" class="btn-alert-pill">+ Restock Bahan</a>
					</div>
				</div>

				<!-- Peringatan 2: Verifikasi Mahasiswa UNISM -->
				<div class="alert-glass-box alert-box-info">
					<div class="alert-box-icon">
						<span>🎓</span>
					</div>
					<div class="alert-box-content">
						<strong class="alert-box-title">Verifikasi Diskon Mahasiswa UNISM (25%)</strong>
						<p class="alert-box-desc">Sistem otomatis mengunci diskon mahasiswa perdana permanen via NIM di cloud TiDB.</p>
					</div>
					<div class="alert-box-action">
						<a href="/admin/pesanan" class="btn-alert-pill">Cek Antrean</a>
					</div>
				</div>

				<!-- Peringatan 3: Payment Gateway Midtrans QRIS -->
				<div class="alert-glass-box alert-box-success">
					<div class="alert-box-icon">
						<span>⚡</span>
					</div>
					<div class="alert-box-content">
						<strong class="alert-box-title">Dynamic QRIS Midtrans: Webhook Terhubung</strong>
						<p class="alert-box-desc">Rekonsiliasi transaksi otomatis settlement via webhook. Selisih finansial Rp 0 (100% akurat).</p>
					</div>
					<div class="alert-box-action">
						<a href="/admin/laporan/ekspor?period=today" class="btn-alert-pill">Audit Finansial</a>
					</div>
				</div>
			</div>
		</section>

		<!-- ROW 4: BILAH EKSPOR LAPORAN AKUNTANSI & AUDIT MUTASI (.CSV) -->
		<div class="glass-export-bar">
			<div class="export-bar-text">
				<strong class="export-bar-title">Ekspor Rekapitulasi Laporan Penjualan &amp; Mutasi Stok (.CSV)</strong>
				<p class="export-bar-desc">Unduh berkas transaksi dan audit mutasi stok format UTF-8 BOM untuk Microsoft Excel &amp; Google Sheets.</p>
			</div>
			<div class="export-bar-actions">
				<a href="/admin/laporan/ekspor?period=today" class="btn-export-glass" download title="Unduh transaksi hari ini">
					<span>📅 Transaksi Hari Ini</span>
				</a>
				<a href="/admin/laporan/ekspor?period=month" class="btn-export-glass" download title="Unduh transaksi bulan berjalan">
					<span>🗓️ Bulan Berjalan</span>
				</a>
				<a href="/admin/laporan/ekspor?period=all" class="btn-export-glass btn-export-glass-primary" download title="Unduh seluruh rekam jejak transaksi">
					<span>📊 Seluruh Transaksi (.CSV)</span>
				</a>
				<a href="/admin/stok/ekspor" class="btn-export-glass" download title="Unduh audit mutasi stok">
					<span>📦 Audit Mutasi Stok (.CSV)</span>
				</a>
			</div>
		</div>

		<!-- Tabel Rincian Kontribusi Produk Terlaris -->
		<div class="glass-collapsible-section" style="margin-top: 1.5rem;">
			<details class="glass-details-frame">
				<summary class="glass-details-summary">
					<span>📊 Lihat Rincian Kontribusi Produk Terlaris ({ fmt.Sprintf("%d menu terdata", len(report.TopProducts)) })</span>
				</summary>
				<div class="glass-table-responsive" style="margin-top: 1rem;">
					<table class="glass-data-table">
						<thead>
							<tr>
								<th>Menu Kafe</th>
								<th class="text-right">Porsi Terjual</th>
								<th class="text-right">Kontribusi Omzet</th>
							</tr>
						</thead>
						<tbody id="tableTopProductsBody">
							for _, p := range report.TopProducts {
								<tr>
									<td><strong>{ p.ProductName }</strong></td>
									<td class="text-right">{ fmt.Sprintf("%d porsi", p.Quantity) }</td>
									<td class="text-right tabular-nums">{ FormatRupiah(p.TotalSales) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</details>
		</div>
	</div>
}

templ adminTabMenu(categories []catalog.Category) {
	<div class="admin-tab-pane">
		<div class="tab-pane-header">
			<div>
				<h2 class="tab-pane-title">Katalog &amp; Varian Menu</h2>
				<p class="tab-pane-desc">Kelola nama menu, kategori saji, penetapan harga dasar, dan varian pesanan.</p>
			</div>
		</div>

		<div class="admin-form-split">
			<section class="admin-form-panel" aria-labelledby="form-add-product-title">
				<h3 id="form-add-product-title" class="form-panel-title">Tambah Menu Baru</h3>
				<p class="form-panel-desc">Menu baru akan langsung tersedia di katalog pelanggan dan inventaris stok.</p>

				<form action="/admin/menu/tambah" method="POST" class="styled-admin-form">
					<div class="form-group">
						<label for="new_category_slug">Kategori Menu</label>
						<select id="new_category_slug" name="category_slug" required class="styled-select">
							for _, c := range categories {
								<option value={ c.Slug }>{ c.Name }</option>
							}
						</select>
					</div>

					<div class="form-group">
						<label for="new_product_name">Nama Menu</label>
						<input type="text" id="new_product_name" name="name" placeholder="Contoh: Kopi Susu Senja" required class="styled-input"/>
					</div>

					<div class="form-group">
						<label for="new_base_price">Harga Dasar (Rupiah)</label>
						<input type="number" id="new_base_price" name="base_price" min="1000" step="500" placeholder="Contoh: 15000" required class="styled-input"/>
					</div>

					<div class="form-group">
						<label for="new_variants">Varian Opsional</label>
						<input type="text" id="new_variants" name="variants" placeholder="Contoh: Ice:3000, Hot:0 (atau kosongkan jika tanpa varian)" class="styled-input"/>
						<small class="form-help">Format: NamaVarian:SelisihHarga. Pisahkan dengan tanda koma.</small>
					</div>

					<button type="submit" class="btn-admin-submit">Simpan Menu Baru</button>
				</form>
			</section>

			<section class="admin-form-panel" aria-labelledby="form-update-price-title">
				<h3 id="form-update-price-title" class="form-panel-title">Perbarui Harga Dasar Menu</h3>
				<p class="form-panel-desc">Ubah harga satuan dasar menu yang sudah terdaftar.</p>

				<form action="/admin/menu/harga" method="POST" class="styled-admin-form">
					<div class="form-group">
						<label for="price_product_slug">Pilih Menu</label>
						<select id="price_product_slug" name="product_slug" required class="styled-select">
							for _, c := range categories {
								<optgroup label={ c.Name }>
									for _, p := range c.Products {
										<option value={ p.Slug }>{ p.Name } ({ FormatRupiah(p.BasePrice) })</option>
									}
								</optgroup>
							}
						</select>
					</div>

					<div class="form-group">
						<label for="updated_new_price">Harga Dasar Baru (Rupiah)</label>
						<input type="number" id="updated_new_price" name="new_price" min="1000" step="500" placeholder="Contoh: 18000" required class="styled-input"/>
					</div>

					<button type="submit" class="btn-admin-submit">Perbarui Harga Menu</button>
				</form>
			</section>
		</div>

		<section class="catalog-list-section" aria-labelledby="catalog-table-title">
			<div class="section-title-wrap">
				<h3 id="catalog-table-title" class="sub-section-title">Daftar Menu Aktif</h3>
				<span class="section-note">Dikelompokkan menurut kategori</span>
			</div>

			<div class="catalog-category-blocks">
				for _, cat := range categories {
					<div class="category-block">
						<div class="cat-block-header">
							<h4 class="cat-block-title">{ cat.Name }</h4>
							<span class="cat-block-count">{ fmt.Sprintf("%d menu", len(cat.Products)) }</span>
						</div>
						<div class="table-frame">
							<table class="report-table">
								<thead>
									<tr>
										<th>Nama Menu</th>
										<th>Varian Tersedia</th>
										<th class="text-right">Harga Dasar</th>
									</tr>
								</thead>
								<tbody>
									for _, p := range cat.Products {
										<tr>
											<td>
												<strong>{ p.Name }</strong>
												<span class="product-slug-label">{ p.Slug }</span>
											</td>
											<td>
												if p.HasVariants() {
													<div class="variant-tags">
														for _, v := range p.Variants {
															<span class="variant-tag-chip">
																{ v.Name }
																if v.PriceDelta > 0 {
																	<span class="variant-delta">+{ FormatRupiah(v.PriceDelta) }</span>
																}
															</span>
														}
													</div>
												} else {
													<span class="no-variant-text">Tanpa Varian</span>
												}
											</td>
											<td class="text-right tabular-nums">
												<strong>{ FormatRupiah(p.BasePrice) }</strong>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</div>
				}
			</div>
		</section>
	</div>
}

templ adminTabStock(stockList []catalog.StockItem, movements []catalog.StockMovement) {
	<div class="admin-tab-pane">
		<div class="tab-pane-header">
			<div>
				<h2 class="tab-pane-title">Kontrol &amp; Penyesuaian Stok</h2>
				<p class="tab-pane-desc">Pantau ketersediaan porsi bahan menu harian dan lakukan pencatatan penyesuaian stok.</p>
			</div>
		</div>

		<div class="admin-form-split">
			<section class="admin-form-panel" aria-labelledby="form-adjust-stock-title">
				<h3 id="form-adjust-stock-title" class="form-panel-title">Penyesuaian Stok Produk</h3>
				<p class="form-panel-desc">Tambah stok masuk (restock) atau kurangi karena penyusutan/koreksi fisik.</p>

				<form action="/admin/stok/sesuaikan" method="POST" class="styled-admin-form">
					<div class="form-group">
						<label for="stock_product_slug">Pilih Menu Produk</label>
						<select id="stock_product_slug" name="product_slug" required class="styled-select">
							for _, it := range stockList {
								<option value={ it.ProductSlug }>
									{ it.ProductName } (Sisa: { fmt.Sprintf("%d", it.Qty) } porsi)
								</option>
							}
						</select>
					</div>

					<div class="form-group">
						<label for="stock_action_type">Jenis Penyesuaian</label>
						<select id="stock_action_type" name="action_type" required class="styled-select">
							<option value="add">Tambah Stok Masuk (Restock / Barang Datang)</option>
							<option value="sub">Kurangi Stok (Koreksi / Rusak / Terbuang)</option>
						</select>
					</div>

					<div class="form-group">
						<label for="stock_change_qty">Jumlah Porsi</label>
						<input type="number" id="stock_change_qty" name="quantity" min="1" step="1" placeholder="Contoh: 15" required class="styled-input"/>
					</div>

					<div class="form-group">
						<label for="stock_reason">Catatan Alasan</label>
						<input type="text" id="stock_reason" name="reason" placeholder="Contoh: Pembelian bahan susu pagi hari" required class="styled-input"/>
					</div>

					<button type="submit" class="btn-admin-submit">Simpan Penyesuaian Stok</button>
				</form>
			</section>

			<section class="admin-form-panel" aria-labelledby="stock-summary-title">
				<h3 id="stock-summary-title" class="form-panel-title">Status Inventaris Kafe</h3>
				<p class="form-panel-desc">Ringkasan kondisi stok menu saat ini.</p>

				<div class="stock-status-summary-cards">
					<div class="summary-stat-box stat-safe">
						<span class="stat-number" id="stockStatSafe">{ fmt.Sprintf("%d", countStockByStatus(stockList, "safe")) }</span>
						<span class="stat-text">Menu Stok Aman</span>
					</div>
					<div class="summary-stat-box stat-low">
						<span class="stat-number" id="stockStatLow">{ fmt.Sprintf("%d", countStockByStatus(stockList, "low")) }</span>
						<span class="stat-text">Menu Stok Menipis (≤ 5)</span>
					</div>
					<div class="summary-stat-box stat-empty">
						<span class="stat-number" id="stockStatEmpty">{ fmt.Sprintf("%d", countStockByStatus(stockList, "empty")) }</span>
						<span class="stat-text">Menu Stok Habis</span>
					</div>
				</div>

				<div class="stock-note-info">
					<p>Menu dengan stok kurang dari atau sama dengan 5 porsi ditandai peringatan agar barista dapat segera menyiapkan restock bahan.</p>
				</div>
			</section>
		</div>

		<section class="stock-inventory-section" aria-labelledby="stock-table-title">
			<div class="section-title-wrap">
				<h3 id="stock-table-title" class="sub-section-title">Daftar Stok Produk</h3>
				<span class="section-note">{ fmt.Sprintf("%d item terdata", len(stockList)) }</span>
			</div>

			<div class="table-frame">
				<table class="report-table">
					<thead>
						<tr>
							<th>Nama Menu</th>
							<th>Kategori</th>
							<th class="text-right">Sisa Stok</th>
							<th class="text-center">Status</th>
						</tr>
					</thead>
					<tbody id="tableStockListBody">
						for _, it := range stockList {
							<tr>
								<td><strong>{ it.ProductName }</strong></td>
								<td>{ it.CategoryName }</td>
								<td class="text-right tabular-nums"><strong>{ fmt.Sprintf("%d porsi", it.Qty) }</strong></td>
								<td class="text-center">
									<span class={ "stock-badge", "badge-" + it.StatusCode() }>
										{ it.StatusLabel() }
									</span>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>

		<div class="admin-export-card" style="margin-top: 1.5rem; margin-bottom: 2rem;">
			<div class="export-card-text">
				<h3 class="export-card-title">Ekspor Riwayat Mutasi Stok (CSV / Excel)</h3>
				<p class="export-card-desc">Unduh seluruh riwayat pergerakan stok barang, restock harian, dan pengurangan pesanan ke format CSV UTF-8.</p>
			</div>
			<div class="export-card-actions">
				<a href="/admin/stok/ekspor" class="btn-export-act btn-export-primary" download title="Unduh berkas CSV mutasi stok">
					<span class="export-icon">📦</span>
					<span>Unduh Mutasi Stok (.CSV)</span>
				</a>
			</div>
		</div>

		<section class="stock-movements-section" aria-labelledby="movements-table-title">
			<div class="section-title-wrap">
				<h3 id="movements-table-title" class="sub-section-title">Catatan Riwayat Pergerakan Stok</h3>
				<span class="section-note">Pencatatan penyesuaian terbaru (Real-Time)</span>
			</div>

			<div class="table-frame">
				<table class="report-table">
					<thead>
						<tr>
							<th>Waktu</th>
							<th>Menu</th>
							<th class="text-right">Perubahan</th>
							<th>Catatan / Alasan</th>
						</tr>
					</thead>
					<tbody id="tableStockMovementsBody">
						if len(movements) == 0 {
							<tr>
								<td colspan="4" class="text-center text-muted">Belum ada catatan mutasi stok.</td>
							</tr>
						} else {
							for _, m := range movements {
								<tr>
									<td><time>{ m.CreatedAt.Format("02/01/2006, 15:04 WIB") }</time></td>
									<td><strong>{ m.ProductName }</strong></td>
									<td class="text-right tabular-nums">
										if m.Change > 0 {
											<span class="change-pos">+{ fmt.Sprintf("%d", m.Change) }</span>
										} else {
											<span class="change-neg">{ fmt.Sprintf("%d", m.Change) }</span>
										}
									</td>
									<td>{ m.Reason }</td>
								</tr>
							}
						}
					</tbody>
				</table>
			</div>
		</section>
	</div>
}

templ adminTabSettings(cfg storeconfig.Config) {
	<div class="admin-tab-pane">
		<div class="tab-pane-header">
			<div>
				<h2 class="tab-pane-title">Pengaturan Kafe &amp; Operasional</h2>
				<p class="tab-pane-desc">Atur ketersediaan penerimaan pesanan, jam buka toko, dan informasi kontak kafe.</p>
			</div>
		</div>

		<div class="admin-form-split">
			<section class="admin-form-panel" aria-labelledby="form-settings-title" style="flex: 1.2;">
				<h3 id="form-settings-title" class="form-panel-title">Parameter Operasional Kafe</h3>
				<p class="form-panel-desc">Perubahan akan langsung berdampak pada halaman pemesanan pelanggan.</p>

				<form action="/admin/pengaturan" method="POST" class="styled-admin-form">
					<div class="form-group">
						<label>Status Buka Toko</label>
						<div class="radio-selector-group">
							<label class="radio-label">
								<input type="radio" name="is_open" value="true" checked?={ cfg.IsOpen }/>
								<span><strong>Kafe Buka</strong> (menerima pesanan meja dan bawa pulang)</span>
							</label>
							<label class="radio-label">
								<input type="radio" name="is_open" value="false" checked?={ !cfg.IsOpen }/>
								<span><strong>Kafe Tutup Sementara</strong> (halaman checkout dihentikan sementara)</span>
							</label>
						</div>
					</div>

					<div class="form-group">
						<label for="set_opening_hours">Jam Operasional Kafe</label>
						<input type="text" id="set_opening_hours" name="opening_hours" value={ cfg.OpeningHours } required class="styled-input"/>
						<small class="form-help">Contoh: 09.00 - 22.00 WITA (Senin sampai Sabtu)</small>
					</div>

					<div class="form-group">
						<label for="set_table_count">Jumlah Meja Aktif</label>
						<input type="number" id="set_table_count" name="table_count" min="1" max="100" value={ fmt.Sprintf("%d", cfg.TableCount) } required class="styled-input"/>
						<small class="form-help">Kapasitas meja untuk pilihan pesanan Makan di Tempat.</small>
					</div>

					<div class="form-group">
						<label for="set_contact_phone">Nomor Telepon / WhatsApp Kafe</label>
						<input type="text" id="set_contact_phone" name="contact_phone" value={ cfg.ContactPhone } required class="styled-input"/>
						<small class="form-help">Untuk bantuan pelanggan saat konfirmasi pesanan.</small>
					</div>

					<div class="form-group">
						<label for="set_address">Alamat Lengkap Kafe</label>
						<input type="text" id="set_address" name="address" value={ cfg.Address } required class="styled-input"/>
						<small class="form-help">Lokasi fisik kafe di lingkungan kampus.</small>
					</div>

					<div class="form-group">
						<label for="set_announcement">Teks Pengumuman Kafe</label>
						<textarea id="set_announcement" name="announcement" rows="3" class="styled-textarea">{ cfg.Announcement }</textarea>
						<small class="form-help">Pemberitahuan khusus promo atau informasi penting bagi pelanggan.</small>
					</div>

					<button type="submit" class="btn-admin-submit">Simpan Pengaturan Kafe</button>
				</form>
			</section>

			<section class="admin-form-panel" aria-labelledby="settings-preview-title" style="flex: 0.8;">
				<h3 id="settings-preview-title" class="form-panel-title">Pratinjau Status Kafe</h3>
				<p class="form-panel-desc">Status aktif yang terbaca oleh sistem saat ini.</p>

				<div class="settings-preview-box">
					<div class="preview-item">
						<span class="preview-label">Kondisi Toko:</span>
						if cfg.IsOpen {
							<span class="preview-tag tag-open">Buka Melayani</span>
						} else {
							<span class="preview-tag tag-closed">Tutup Sementara</span>
						}
					</div>
					<div class="preview-item">
						<span class="preview-label">Jam Layanan:</span>
						<strong>{ cfg.OpeningHours }</strong>
					</div>
					<div class="preview-item">
						<span class="preview-label">Kapasitas Meja:</span>
						<strong>{ fmt.Sprintf("%d meja", cfg.TableCount) }</strong>
					</div>
					<div class="preview-item">
						<span class="preview-label">Kontak Meja Kasir:</span>
						<strong>{ cfg.ContactPhone }</strong>
					</div>
					<div class="preview-item">
						<span class="preview-label">Alamat Kafe:</span>
						<strong>{ cfg.Address }</strong>
					</div>
					<div class="preview-item">
						<span class="preview-label">Pengumuman:</span>
						<p class="preview-announcement">{ cfg.Announcement }</p>
					</div>
				</div>
			</section>
		</div>
	</div>
}

func countStockByStatus(items []catalog.StockItem, status string) int {
	var count int
	for _, it := range items {
		if it.StatusCode() == status {
			count++
		}
	}
	return count
}
