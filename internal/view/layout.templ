package view

import (
	"caffe-podjok-sendja/internal/customer"
	"caffe-podjok-sendja/internal/storeconfig"
)

templ Layout(title string, cust *customer.Customer, content templ.Component) {
	<!DOCTYPE html>
	<html lang="id">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="theme-color" content="#2A1D17"/>
			<title>{ title }</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Fraunces:opsz,wght@9..144,500;9..144,650&display=swap" rel="stylesheet"/>
			<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body id="top" class="site-table">
			<header class="site-header">
				<a class="wordmark brand-link" href="/menu">
					<span class="brand-logo-frame">
						<img src="/static/images/logo.png?v=2" alt="Logo Caffe Sari Mulia" class="brand-logo" width="34" height="34"/>
					</span>
					<span class="brand-title">Podjok Sendja</span>
				</a>
				<nav aria-label="Navigasi utama" class="main-nav desktop-nav">
					<a class="nav-link" href="/menu">Menu</a>
					<a class="nav-link" href="/keranjang">Keranjang</a>
					<a class="nav-link" href="/lacak">Lacak</a>
					if cust != nil {
						<a class="nav-link nav-link-user" href="/akun" title="Buka Akun Saya">
							<span class="nav-user-text">Halo, { cust.ShortName() }</span>
							if cust.Type == customer.CustomerTypeMahasiswa {
								<span class="nav-badge-mhs">Mhs</span>
							}
						</a>
						<a class="nav-link nav-link-auth" href="/keluar">Keluar</a>
					} else {
						<a class="nav-link nav-link-auth" href="/masuk">Masuk</a>
					}
				</nav>
				<div class="mobile-header-actions">
					if cust != nil {
						<a class="mobile-user-badge" href="/akun" title="Buka Akun Saya">
							<span class="mobile-user-avatar">{ string([]rune(cust.Name)[0:1]) }</span>
							<span class="mobile-user-name">{ cust.ShortName() }</span>
							if cust.Type == customer.CustomerTypeMahasiswa {
								<span class="nav-badge-mhs">Mhs</span>
							}
						</a>
						<a class="mobile-exit-link" href="/keluar" title="Keluar">Keluar</a>
					} else {
						<a class="mobile-auth-btn" href="/masuk">Masuk</a>
					}
				</div>
			</header>
			<main class="site-main">
				@content
			</main>
			<footer class="site-footer">
				<div class="footer-content">
					<div class="footer-info">
						<p class="footer-brand">Caffe Podjok Sendja, Universitas Sari Mulia</p>
						<address class="footer-address">{ storeconfig.DefaultStore.Get().Address }</address>
					</div>
					<div class="footer-links">
						if cust != nil {
							<a class="footer-link" href="/akun">Akun Saya</a>
							<span class="footer-sep">•</span>
						} else {
							<a class="footer-link" href="/masuk">Masuk Akun</a>
							<span class="footer-sep">•</span>
							<a class="footer-link" href="/daftar">Daftar Akun</a>
							<span class="footer-sep">•</span>
						}
						<a class="back-to-top" href="#top">Kembali ke atas</a>
					</div>
				</div>
			</footer>
			<nav class="mobile-bottom-nav" aria-label="Navigasi cepat ponsel">
				<a class="mobile-bottom-tab" href="/menu">
					<svg class="mobile-tab-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
						<path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
						<line x1="6" y1="1" x2="6" y2="4"></line>
						<line x1="10" y1="1" x2="10" y2="4"></line>
						<line x1="14" y1="1" x2="14" y2="4"></line>
					</svg>
					<span class="mobile-tab-label">Menu</span>
				</a>
				<a class="mobile-bottom-tab" href="/keranjang">
					<svg class="mobile-tab-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="9" cy="21" r="1"></circle>
						<circle cx="20" cy="21" r="1"></circle>
						<path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
					</svg>
					<span class="mobile-tab-label">Keranjang</span>
				</a>
				<a class="mobile-bottom-tab" href="/lacak">
					<svg class="mobile-tab-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
						<polyline points="14 2 14 8 20 8"></polyline>
						<line x1="16" y1="13" x2="8" y2="13"></line>
						<line x1="16" y1="17" x2="8" y2="17"></line>
						<polyline points="10 9 9 9 8 9"></polyline>
					</svg>
					<span class="mobile-tab-label">Lacak</span>
				</a>
				if cust != nil {
					<a class="mobile-bottom-tab" href="/akun">
						<svg class="mobile-tab-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
							<circle cx="12" cy="7" r="4"></circle>
						</svg>
						<span class="mobile-tab-label">Akun</span>
					</a>
				} else {
					<a class="mobile-bottom-tab" href="/masuk">
						<svg class="mobile-tab-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
							<polyline points="10 17 15 12 10 7"></polyline>
							<line x1="15" y1="12" x2="3" y2="12"></line>
						</svg>
						<span class="mobile-tab-label">Masuk</span>
					</a>
				}
			</nav>
		</body>
	</html>
}
